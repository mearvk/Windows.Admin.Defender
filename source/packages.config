<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK / SDK NuGet packages used to build the kernel minifilter in CI without
  relying on a machine-wide WDK Visual Studio extension. Restored with
  `nuget restore source/packages.config`. See Microsoft's guidance:
  https://learn.microsoft.com/windows-hardware/drivers/install-the-wdk-using-nuget
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.26100.4654" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.26100.4654" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.26100.4654" targetFramework="native" />
</packages>
