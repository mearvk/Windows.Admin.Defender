[Version]
Signature = "$WINDOWS NT$"
Class = System
ClassGuid = {78A1C341-4539-11D3-B88D-00C04FAD5171}
Provider = %ProviderName%
DriverVer = 09/13/2026,1.0.0.0
CatalogFile = WindowsAdminDefender.cat

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles
AddReg = MiniFilter.AddReg

[DefaultInstall.NTamd64.Services]
AddService = WindowsAdminDefender,0x00000002,WindowsAdminDefender_Service

[DefaultInstall.NTarm64]
CopyFiles = DriverCopyFiles
AddReg = MiniFilter.AddReg

[DefaultInstall.NTarm64.Services]
AddService = WindowsAdminDefender,0x00000002,WindowsAdminDefender_Service

[Manufacturer]
%ProviderName% = Standard,NTamd64,NTarm64

[Standard.NTamd64]
%DeviceName% = DriverInstall, Root\\WindowsAdminDefender

[Standard.NTarm64]
%DeviceName% = DriverInstall, Root\\WindowsAdminDefender

[DriverInstall]
CopyFiles = DriverCopyFiles
AddReg = MiniFilter.AddReg

[DriverInstall.Services]
AddService = WindowsAdminDefender,0x00000002,WindowsAdminDefender_Service

[WindowsAdminDefender_Service]
DisplayName = %ServiceName%
Description = %ServiceDescription%
ServiceType = 2
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\\WindowsAdminDefender.sys
LoadOrderGroup = "FSFilter Activity Monitor"

[MiniFilter.AddReg]
HKR, "Instances", "DefaultInstance", 0x00000000, "Windows Admin Defender Instance"
HKR, "Instances\\Windows Admin Defender Instance", "Altitude", 0x00000000, "370030"
HKR, "Instances\\Windows Admin Defender Instance", "Flags", 0x00010001, 0

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
WindowsAdminDefender.sys = 1

[DestinationDirs]
DriverCopyFiles = 13

[DriverCopyFiles]
WindowsAdminDefender.sys

[Strings]
DiskName = "Windows Admin Defender Installation Media"
ProviderName = "Windows Admin Defender"
DeviceName = "Windows Admin Defender File-System Minifilter"
ServiceName = "Windows Admin Defender File-System Minifilter"
ServiceDescription = "Windows Admin Defender directory-handle protection file-system minifilter."
