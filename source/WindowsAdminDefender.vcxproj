<?xml version="1.0" encoding="utf-8"?>
<!--
  WindowsAdminDefender.vcxproj
  WDK file-system minifilter (kernel-mode) project for source/WindowsAdminDefender.c.

  This project targets the Windows Driver Kit (WDK) "WindowsKernelModeDriver"
  configuration. It requires the WDK to be installed alongside Visual Studio so
  the WDK MSBuild targets ($(WDKContentRoot)) and Filter Manager (fltMgr.lib)
  are available. It does not disable driver-signing policy, Secure Boot,
  Defender, Device Guard, or UAC. Catalog generation and signing remain a
  separate, explicit packaging step.
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F2D8B41-2C7A-4E19-9B33-3C1A5E7D9A01}</ProjectGuid>
    <TemplateGuid>{497e31cb-01e3-4e64-8f61-1eee3e8d2f77}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RootNamespace>WindowsAdminDefender</RootNamespace>
    <DriverType>WDM</DriverType>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.props" Condition="Exists('$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.props')" />

  <!--
    WDK / SDK NuGet package props (restored from source/packages.config).
    These supply the kernel headers (ntddk.h, fltKernel.h) and libraries when
    the WDK is not installed as a machine-wide Visual Studio extension, e.g. on
    hosted CI runners. Paths follow the standard NuGet packages\ layout.
  -->
  <!-- Discover the restored package directories by glob so the exact patch
       version (which differs between the WDK and SDK packages) does not have
       to be hard-coded. The globs are resolved into properties because an
       <Import> Condition cannot reference an item list (@(...)) directly. -->
  <PropertyGroup Label="WdkNuGet">
    <!-- WadPackagesDir can be overridden on the MSBuild command line; CI passes
         the restore output directory. -->
    <WadPackagesDir Condition="'$(WadPackagesDir)' == ''">$(MSBuildThisFileDirectory)..\packages\</WadPackagesDir>
  </PropertyGroup>
  <ItemGroup>
    <WadWdkPropsItem Include="$(WadPackagesDir)Microsoft.Windows.WDK.x64.*\build\native\Microsoft.Windows.WDK.x64.props" />
    <WadWdkTargetsItem Include="$(WadPackagesDir)Microsoft.Windows.WDK.x64.*\build\native\Microsoft.Windows.WDK.x64.targets" />
    <WadSdkPropsItem Include="$(WadPackagesDir)Microsoft.Windows.SDK.CPP.*\build\native\Microsoft.Windows.SDK.CPP.props" />
    <WadSdkTargetsItem Include="$(WadPackagesDir)Microsoft.Windows.SDK.CPP.*\build\native\Microsoft.Windows.SDK.CPP.targets" />
  </ItemGroup>
  <PropertyGroup>
    <WadWdkProps>@(WadWdkPropsItem)</WadWdkProps>
    <WadWdkTargets>@(WadWdkTargetsItem)</WadWdkTargets>
    <WadSdkProps>@(WadSdkPropsItem)</WadSdkProps>
    <WadSdkTargets>@(WadSdkTargetsItem)</WadSdkTargets>
  </PropertyGroup>
  <ImportGroup Label="WdkNuGetProps">
    <Import Project="$(WadSdkProps)" Condition="'$(WadSdkProps)' != '' and Exists('$(WadSdkProps)')" />
    <Import Project="$(WadWdkProps)" Condition="'$(WadWdkProps)' != '' and Exists('$(WadWdkProps)')" />
  </ImportGroup>

  <ImportGroup Label="PropertySheets" />

  <PropertyGroup>
    <TargetName>WindowsAdminDefender</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WppEnabled>false</WppEnabled>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <PreprocessorDefinitions>POOL_NX_OPTIN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(Configuration)' == 'Release'">
      <Optimization>MinSpace</Optimization>
    </ClCompile>
    <Link>
      <!-- Filter Manager import library for the minifilter APIs used in DriverEntry. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)fltMgr.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="WindowsAdminDefender.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="WindowsAdminDefender.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="WindowsAdminDefender.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.targets" Condition="Exists('$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.targets')" />

  <!-- WDK / SDK NuGet package targets (restored under $(WadPackagesDir)). -->
  <ImportGroup Label="WdkNuGetTargets">
    <Import Project="$(WadSdkTargets)" Condition="'$(WadSdkTargets)' != '' and Exists('$(WadSdkTargets)')" />
    <Import Project="$(WadWdkTargets)" Condition="'$(WadWdkTargets)' != '' and Exists('$(WadWdkTargets)')" />
  </ImportGroup>

  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WadWdkProps)' == '' or !Exists('$(WadWdkProps)')"
           Text="WDK NuGet package not restored under $(WadPackagesDir). Run 'nuget install Microsoft.Windows.WDK.x64 -OutputDirectory source/packages' before building." />
  </Target>
</Project>
