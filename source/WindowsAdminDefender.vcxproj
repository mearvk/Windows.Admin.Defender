<?xml version="1.0" encoding="utf-8"?>
<!--
  WindowsAdminDefender.vcxproj
  WDK file-system minifilter (kernel-mode) project for source/WindowsAdminDefender.c.

  This project targets the Windows Driver Kit (WDK) "WindowsKernelModeDriver"
  configuration. It requires the WDK to be installed alongside Visual Studio so
  the WDK MSBuild targets ($(WDKContentRoot)) and Filter Manager (fltMgr.lib)
  are available. It does not disable driver-signing policy, Secure Boot,
  Defender, Device Guard, or UAC. Catalog generation and signing remain a
  separate, explicit packaging step.
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F2D8B41-2C7A-4E19-9B33-3C1A5E7D9A01}</ProjectGuid>
    <TemplateGuid>{497e31cb-01e3-4e64-8f61-1eee3e8d2f77}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RootNamespace>WindowsAdminDefender</RootNamespace>
    <DriverType>WDM</DriverType>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.props" Condition="Exists('$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.props')" />

  <ImportGroup Label="PropertySheets" />

  <PropertyGroup>
    <TargetName>WindowsAdminDefender</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WppEnabled>false</WppEnabled>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <PreprocessorDefinitions>POOL_NX_OPTIN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(Configuration)' == 'Release'">
      <Optimization>MinSpace</Optimization>
    </ClCompile>
    <Link>
      <!-- Filter Manager import library for the minifilter APIs used in DriverEntry. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)fltMgr.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="WindowsAdminDefender.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="WindowsAdminDefender.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="WindowsAdminDefender.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.targets" Condition="Exists('$(VCTargetsPath)\Microsoft.Cpp.WindowsKernelModeDriver.10.0.targets')" />
</Project>
